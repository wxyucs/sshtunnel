{
  "state_dir": "~/Library/Application Support/sshtunnel",
  "web": {
    "bind_host": "127.0.0.1",
    "port": 8787
  },
  "proxies": [
    {
      "name": "primary",
      "start_by_default": true,
      "ssh_host": "proxy-one.example.org",
      "ssh_user": "root",
      "ssh_port": 22,
      "identity_file": "~/.ssh/id_ed25519",
      "bind_host": "127.0.0.1",
      "socks_port": 1080,
      "server_alive_interval": 15,
      "server_alive_count_max": 3,
      "restart_delay": 5
    },
    {
      "name": "backup",
      "start_by_default": false,
      "ssh_host": "192.0.2.10",
      "ssh_user": "tunnel",
      "ssh_port": 2222,
      "identity_file": "",
      "bind_host": "127.0.0.1",
      "socks_port": 1081,
      "server_alive_interval": 15,
      "server_alive_count_max": 3,
      "restart_delay": 5
    }
  ]
}
